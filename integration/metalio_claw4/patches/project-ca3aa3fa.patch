+void LaunchLearning(screen_lifecycle_cb_t lifecycle_cb) {
+    lv_obj_t* old_scr = lv_screen_active();
+    lv_obj_t* app = LearningScreen::Create();
+    if (app == nullptr) {
+        ESP_LOGE(TAG_HOME, "LearningScreen::Create() failed");
+        return;
+    }
+    screen_attach_lifecycle(app, lifecycle_cb);
+    lv_screen_load(app);
+    if (old_scr != nullptr && old_scr != app) {
+        lv_obj_delete_async(old_scr);
+    }
+}
+
+void learning_lifecycle_cb(screen_lifecycle_event_t event) {
+    if (event == SCREEN_LIFECYCLE_LOAD) {
+        ESP_LOGI(TAG_HOME, "load: learning_screen");
+    } else {
+        ESP_LOGI(TAG_HOME, "unload: learning_screen");
+    }
+    LearningScreen::LifecycleCallback(event);
 }
 
