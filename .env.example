# Claw4 Host-MVP environment template.
# Copy to .env and adjust locally. NO real secrets, keys or production
# values belong here — the family backend runs on synthetic dev data and a
# development-session parent stub.

# Database URL. Host-MVP default is a local SQLite file (created in the
# backend working directory). PostgreSQL deployment example:
#   CLAW4_DATABASE_URL=postgresql+psycopg://claw4:change-me@127.0.0.1:5432/claw4
# The repository keeps all SQL dialect-specific code out of business logic
# (SQLAlchemy ORM only), so switching dialects changes this URL alone.
CLAW4_DATABASE_URL=sqlite:///./.claw4_host_mvp.db

# Local date/timezone used for "today" task scheduling & dashboards.
# IANA name; the machine must have tzdata (bundled via the tzdata pip pkg).
CLAW4_TZ=Asia/Shanghai
