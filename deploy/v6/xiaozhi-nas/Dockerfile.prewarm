FROM ghcr.io/xinnan-tech/xiaozhi-esp32-server:server_0.9.6@sha256:9cf52d6b79c9d157356aba2c8bf1db645c2d2db4f14720c28128920020addccc

COPY edge-tts.requirements.txt /tmp/edge-tts.requirements.txt
RUN python -m pip install --no-deps --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/edge-tts.requirements.txt \
    && python -c "import importlib.metadata; version = importlib.metadata.version('edge-tts'); assert version == '7.3.1', version" \
    && rm /tmp/edge-tts.requirements.txt

COPY patch_ollama_voice.py /tmp/patch_ollama_voice.py
RUN python /tmp/patch_ollama_voice.py /opt/xiaozhi-esp32-server/core/providers/llm/ollama/ollama.py \
    && rm /tmp/patch_ollama_voice.py

COPY patch_asr_voice.py /tmp/patch_asr_voice.py
RUN python /tmp/patch_asr_voice.py /opt/xiaozhi-esp32-server/core/providers/asr/base.py \
    && rm /tmp/patch_asr_voice.py

COPY claw4_ollama_prewarm.py /opt/xiaozhi-esp32-server/core/utils/claw4_ollama_prewarm.py
COPY patch_ollama_prewarm.py /tmp/patch_ollama_prewarm.py
RUN python /tmp/patch_ollama_prewarm.py /opt/xiaozhi-esp32-server/core/connection.py \
    && rm /tmp/patch_ollama_prewarm.py

COPY claw4-m1-voice-prompt.txt /opt/xiaozhi-esp32-server/claw4-m1-voice-prompt.txt
