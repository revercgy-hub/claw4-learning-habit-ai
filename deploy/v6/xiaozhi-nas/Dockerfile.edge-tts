FROM ghcr.io/xinnan-tech/xiaozhi-esp32-server:server_0.9.6@sha256:9cf52d6b79c9d157356aba2c8bf1db645c2d2db4f14720c28128920020addccc

COPY edge-tts.requirements.txt /tmp/edge-tts.requirements.txt

RUN python -m pip install \
      --no-deps \
      --no-cache-dir \
      --require-hashes \
      --only-binary=:all: \
      -r /tmp/edge-tts.requirements.txt \
    && python -c "import importlib.metadata; version = importlib.metadata.version('edge-tts'); assert version == '7.3.1', version" \
    && rm /tmp/edge-tts.requirements.txt
